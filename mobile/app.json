{
  "expo": {
    "name": "كاتب — Kateb",
    "slug": "kateb-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "kateb",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#050505"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kateb.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "GADApplicationIdentifier": "ca-app-pub-3940256099942544~1458002511",
        "SKAdNetworkItems": [
          { "SKAdNetworkIdentifier": "cstr6suwn9.skadnetwork" }
        ],
        "NSUserTrackingUsageDescription": "نستخدم هذا الإذن لعرض إعلانات أكثر صلة بك. يمكنك رفضه."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#050505"
      },
      "package": "com.kateb.mobile",
      "versionCode": 1,
      "permissions": [
        "com.android.vending.BILLING",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 34,
            "targetSdkVersion": 34,
            "minSdkVersion": 24,
            "buildToolsVersion": "34.0.0",
            "kotlinVersion": "1.9.23",
            "extraMavenRepos": [
              "https://maven.google.com"
            ]
          },
          "ios": {
            "deploymentTarget": "13.4",
            "useFrameworks": "static"
          }
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "android_app_id": "ca-app-pub-1908291820966789~1038213094",
          "ios_app_id": "ca-app-pub-3940256099942544~1458002511",
          "user_tracking_usage_description": "نستخدم هذا الإذن لعرض إعلانات أكثر صلة بك. يمكنك رفضه.",
          "delay_app_measurement_init": true,
          "optimize_initialization": true,
          "optimize_ad_loading": true
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "REPLACE_WITH_YOUR_EAS_PROJECT_ID"
      }
    }
  }
}
